  "regulatoryProtectionRules": {
    "description": "Regulatory terms must not be replaced in MISH, safety forms, OSHA/WISHA, or other compliance communication.",
    "protectedTerms": [
      "Competent Person",
      "Qualified Person",
      "Authorized Person",
      "Hazard Communication",
      "Personal Protective Equipment (PPE)",
      "Stop Work Authority",
      "Incident"
    ],
    "disallowedReplacements": {
      "Competent Person": ["Command Person", "Safety Commander"],
      "Qualified Person": ["Certified Operator"],
      "Authorized Person": ["Cleared Operator"],
      "Hazard Communication": ["Hazard Intel"],
      "Personal Protective Equipment (PPE)": ["Protective Posture"],
      "Stop Work Authority": ["Operational Pause"]
    }
  },
  "guardrails": {
    "seoPrecedence": [
      "Use construction terminology first in SEO-facing labels and metadata.",
      "Use veteran or military-themed terms only as a secondary clarifier.",
      "Do not use slogan-heavy or militarized aliases as primary SEO labels."
    ],
    "audienceDistinctions": [
      "Project Stakeholders refers to external audiences in project outcomes.",
      "Trade Partners refers to subcontractors, vendors, and supply-chain collaborators.",
      "Do not interchange Project Stakeholders and Trade Partners."
    ],
    "trustAndCompliance": [
      "Do not remove trust or accreditation surfaces during terminology changes.",
      "Preserve factual ownership phrasing and license verification language.",
      "Preserve accessibility clarity for headings, labels, and ARIA text."
    ]
  }
